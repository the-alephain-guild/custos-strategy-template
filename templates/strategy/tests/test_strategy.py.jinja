"""What the runner and the backtest rely on, whatever the strategy calls things inside.

Both import refinement/{{ engine }}/strategy.py and then build the strategy that
module registered under this directory's name, from this directory's
config.yaml. Tests of the strategy's own rules go below this one.
"""

import importlib
from pathlib import Path

from custos_toolkit.config import load_config

STRATEGY_DIR = Path(__file__).resolve().parents[1]


def test_the_strategy_registers_under_its_directory_name_and_builds() -> None:
    from custos_toolkit_nautilus.adapter import create_strategy

    importlib.import_module("refinement.{{ engine }}.strategy")
    config = load_config(STRATEGY_DIR / "config.yaml")
    assert create_strategy(STRATEGY_DIR.name, config_wrapper=config) is not None
