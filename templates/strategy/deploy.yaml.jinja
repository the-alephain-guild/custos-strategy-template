# How this strategy is deployed through ARX (`make deploy-preview`, `make deploy`).
# Backtests and `make start` ignore it. Every field below but product is sent in
# the DeploymentSpec, whose fields ARX's Release & Deployment API guide describes;
# docs/deploying.md says where they come from. What the strategy trades -- connector,
# pairs, leverage -- is not here: it comes from the release itself, and
# config.yaml must agree with it.
#
# Decimals are written as strings in quotes ('0.25'): ARX refuses a number with a
# fraction, and so does this tool.

# Why this deployment is made, 10 to 500 characters, recorded with it. Left out,
# it reads "Deploy <strategy> <version> to <mode>".
# reason: "First sandbox run of this release"

# The product this strategy's deployments trade for: ARX keeps one per strategy
# and mode, for every release of it. The first make deploy in a mode creates it
# when ARX has none, with this name (1 to 120 characters) and the one currency it
# holds capital in; later runs find it and do not read these again.
product:
  display_name: null
  currency: {{ settlement_currency | upper }}

# The engine's log level.
log_level: INFO

# Parameter overrides for this deployment. {} runs the release's own config.yaml.
# A trading section is refused: the release's trading scope is the only source.
strategy_config: {}

# Engine settings passed to the runner. {} for none.
nautilus_config: {}

# The risk envelope the platform holds the deployment to. The policy's id is
# derived from its content unless you name one with policy_id.
risk_policy:
  version: 1
  policy:
    schema_version: 1
    trading_day:
      time_zone: Etc/UTC
      boundary_local_time: "00:00:00"
    max_total_exposure:
      currency: {{ settlement_currency | upper }}
      amount: "10000"
    max_total_drawdown_ratio: "0.2"
    # Either {kind: ratio, limit: '0.05', base: start_of_day_cash_flow_adjusted_nav}
    # or {kind: absolute, value: {currency: ..., amount: '...'}}.
    max_daily_loss:
      kind: ratio
      limit: "0.05"
      base: start_of_day_cash_flow_adjusted_nav
    max_notional_leverage: "2"
    # A ratio from '0' to '1', or null for no cap.
    max_single_strategy_allocation_ratio: null
    cooldown_seconds: 300

# When the deployment may trade. An empty schedule places no restriction.
scheduling_policy:
  timezone: Etc/UTC
  schedule: {}

# Where each venue's ledger is read from for reconciliation: a list of
# {venue: <name>, ledger_source: venue_api or drop_copy}, at least one, each
# venue once. ARX refuses an empty list. The venue is the runner's name for the
# exchange the strategy's connector trades on.
venue_source_policy:
  - venue: {{ ledger_venue }}
    ledger_source: venue_api

# The reports the runner must be able to produce, each at version "v1". ARX
# requires all five sections; valuation_checkpoint is the one report that may
# be left out.
runner_contract_requirements:
  risk:
    schema_version: 1
    equity_snapshot: v1
    heartbeat: v1
    position_snapshot: v1
  settlement:
    schema_version: 1
    fee: v1
    fill: v1
    period_closed: v1
    position_closed: v1
  reconciliation:
    schema_version: 1
    execution_fill: v1
    reconciliation_period_closed: v1
    valuation_checkpoint: v1
    venue_ledger_snapshot_chunk: v1
    venue_ledger_snapshot_manifest: v1
  health:
    schema_version: 1
    heartbeat: v1
  deployment_lifecycle:
    schema_version: 1
    deployment_lifecycle: v1

# Per mode: the engine binding of the execution channel, and the credential entry
# in the runner's vault the deployment trades with (its id, and the digest it was
# stored with; the runner refuses to start if they differ). Fill these in from
# the runner's vault entry before previewing (docs/deploying.md, step 3f).
sandbox:
  engine_binding_id: null
  credential_scope:
    scope_id: null
    scope_digest: null
  # The simulated account the first instance starts with.
  starting_balances: ["10000 {{ settlement_currency }}"]

testnet:
  engine_binding_id: null
  credential_scope:
    scope_id: null
    scope_digest: null
  # What a stopped instance does with its open positions. Without it they are
  # kept; flatten closes them, which is what a testnet run usually wants.
  shutdown_policy:
    schema_version: 1
    position_policy: flatten
    confirmation_timeout_secs: 30
