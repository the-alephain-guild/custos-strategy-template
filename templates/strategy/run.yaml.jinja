# How this strategy runs on a local Custos runner (`make run`). Backtests ignore it.

# The name this strategy's exchange keys are sealed under in the local vault. Each
# mode has its own: <name>-sandbox holds a placeholder, sealed by `make run` when
# missing, since sandbox never sends a key to the exchange; <name>-testnet holds a
# key from the exchange's test environment, sealed with
# `make runner-vault STRATEGY=... MODE=testnet`.
credential_id: {{ exchange }}-{{ name }}

# The simulated account a sandbox run starts with.
sandbox:
  starting_balances: ["10000 {{ settlement_currency }}"]

# Ceilings enforced by the runner itself, on top of the strategy's own risk
# settings in config.yaml. Leaving max_total_notional out applies Custos's
# strictest default of 200, which an ordinary position exceeds on its first
# trade. Set it somewhat above the largest exposure your sizing can reach.
risk_config:
  max_total_notional: 1000
{%- if exchange == 'okx' %}

# OKX account settings. region is global, eea or us, after the site your account
# is registered on; margin_mode is cross or isolated.
venue:
  region: global
  margin_mode: cross
{%- elif exchange == 'sodex' %}

# SoDEX account settings. Sandbox needs only the settlement currency. Testnet also
# needs the wallet the API key was registered for and that wallet's numeric
# account id on the {{ 'perpetual' if connector == 'sodex_perpetual' else 'spot' }} engine; uncomment and fill them in.
venue:
  settlement_currency: {{ settlement_currency }}
  # wallet_address: "0x..."
  # sodex_account_id: "12345"
{%- endif %}
