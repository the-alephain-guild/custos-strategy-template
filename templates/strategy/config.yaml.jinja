# Settings for {{ name }}. Only what differs from the framework defaults is
# written here; every other section (position sizing, risk limits, filters,
# warmup) falls back to the defaults shipped with the strategy toolkit.

strategy:
  name: "{{ name }}"
  version: "0.1.0"
  description: "{{ description }}"

parameters:
  lookback:
    value: 20
    type: integer
    minimum: 1

trading:
  connector:
    value: "{{ connector }}"
  pairs:
    value: ["{{ trading_pair }}"]

# Indicators need history before the strategy can decide anything, and until they
# have it every bar is held back without a word in the log. "warmup" loads that
# history from the exchange when the strategy starts. With "none" the strategy
# waits for it to accumulate live: at 1-HOUR bars that is most of a day of silence.
warmup:
  mode:
    value: "warmup"

# The exchange's venue follows from trading.connector; nothing here names it.
platforms:
  nautilus:
    bar_type:
      value: "{{ bar_type }}"
