# Local sources for the dev toolchain. Copy this file to toolchain.local.toml,
# which is not committed, keep the entries you want, then run `make setup-dev`
# and add TOOLCHAIN=dev to test, backtest and start. Anything left out stays at the
# version pinned in toolchain.lock.toml. See docs/dev-toolchain.md.

[custos]
# A Custos repository. Only its history is read: the commit below is checked out
# on its own under .toolchain/dev-sources/, so the repository's working directory
# can have uncommitted changes and new commits without affecting this.
source = "/path/to/custos"
# The commit to run. A commit that exists only locally works; uncommitted changes
# do not, since every build here is of a commit. To try a newer Custos, change it
# and run `make setup-dev` again.
revision = "0000000"
# Tag for the runner image `make setup-dev` builds from that commit, for
# `make start TOOLCHAIN=dev`. Its NautilusTrader is the released one, whatever wheel
# is named below.
runner_image = "custos-runner:dev"

[nautilus_trader]
# A NautilusTrader wheel built for this machine from a checkout of the fork:
#   scripts/guild/build-local-wheel.sh ~/.cache/alephain-wheels/nautilus_trader
wheel = "/path/to/nautilus_trader-2.0.0rc5+sodex.2-cp312-cp312-macosx_11_0_arm64.whl"
